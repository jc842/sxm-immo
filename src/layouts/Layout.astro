---
import Matomo from '../components/analytics/Matomo.astro';
import { siteConfig } from '../config/site.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = '/images/og-image.jpg',
  lang = 'fr',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || siteConfig.url);
const alternateFr = new URL(Astro.url.pathname.replace(/^\/(en|es)/, ''), siteConfig.url);
const alternateEn = new URL('/en' + Astro.url.pathname.replace(/^\/(en|es)/, ''), siteConfig.url);
const alternateEs = new URL('/es' + Astro.url.pathname.replace(/^\/(en|es)/, ''), siteConfig.url);
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth bg-stone-950 text-stone-100 antialiased selection:bg-amber-600 selection:text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="alternate" hreflang="fr" href={alternateFr} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="es" href={alternateEs} />
    <link rel="alternate" hreflang="x-default" href={alternateFr} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={image} />

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style is:global>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
    </style>
    <!-- Matomo Tag Manager (Privacy-First / Cookieless) -->
  <Matomo />
</head>
  <body class="flex min-h-screen flex-col bg-stone-950 text-stone-200">
    <!-- Header Williamsburg -->
    <header class="sticky top-0 z-50 border-b border-amber-950/60 bg-stone-950/90 backdrop-blur-md">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6">
        <a href="/" class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-gradient-to-br from-amber-600 to-orange-700 font-extrabold text-white shadow-md shadow-orange-900/40">
            SXM
          </div>
          <div>
            <span class="block text-base font-extrabold tracking-tight text-white">SXM IMMO</span>
            <span class="block text-[10px] font-semibold tracking-wider text-amber-500 uppercase">Saint-Martin & Sint Maarten</span>
          </div>
        </a>

        <!-- Navigation Links -->
        <nav class="hidden md:flex items-center gap-7 text-xs font-semibold text-stone-300">
          <a href="/blog/" class="hover:text-amber-400 transition-colors">TERRES BASSES</a>
          <a href="/blog/" class="hover:text-amber-400 transition-colors">ORIENT BAY</a>
          <a href="/blog/" class="hover:text-amber-400 transition-colors">SINT MAARTEN</a>
          <a href="/mentions-legales/" class="hover:text-amber-400 transition-colors">CONSEIL JURIDIQUE</a>
        </nav>

        <!-- Languages & Badges -->
        <div class="flex items-center gap-3">
          <div class="hidden sm:flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-950/30 px-3 py-1 text-[11px] text-amber-300 font-semibold">
            <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
            ÎLE BINATIONALE
          </div>
          <div class="flex items-center gap-1.5 text-xs text-stone-400 border-l border-stone-800 pl-3 font-semibold">
            <a href="/" class="px-1.5 py-0.5 rounded text-white bg-stone-800">FR</a>
            <a href="/en/" class="px-1.5 py-0.5 rounded hover:text-white">EN</a>
            <a href="/es/" class="px-1.5 py-0.5 rounded hover:text-white">ES</a>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer Williamsburg -->
    <footer class="border-t border-stone-800 bg-stone-900/60 py-12 text-stone-400 text-xs">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
          <div class="md:col-span-2">
            <div class="flex items-center gap-2 mb-3">
              <div class="h-7 w-7 rounded bg-gradient-to-br from-amber-600 to-orange-700 font-bold text-white flex items-center justify-center text-xs">SXM</div>
              <span class="text-sm font-bold text-white">SXM IMMO OBSERVATOIRE</span>
            </div>
            <p class="text-xs text-stone-400 leading-relaxed max-w-md">
              Portail de référence pour l'acquisition immobilière, les villas de prestige et les investissements locatifs dans la Collectivité d'Outre-Mer de Saint-Martin et le pays autonome de Sint Maarten.
            </p>
          </div>
          <div>
            <h4 class="text-stone-200 font-semibold mb-3 tracking-wider text-[11px] uppercase">Navigation</h4>
            <ul class="space-y-2 text-stone-400">
              <li><a href="/" class="hover:text-amber-400 transition-colors">Accueil</a></li>
              <li><a href="/blog/" class="hover:text-amber-400 transition-colors">Tous les Guides SXM</a></li>
              <li><a href="/en/" class="hover:text-amber-400 transition-colors">English Edition</a></li>
              <li><a href="/es/" class="hover:text-amber-400 transition-colors">Edición en Español</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-stone-200 font-semibold mb-3 tracking-wider text-[11px] uppercase">Légal & Normes</h4>
            <ul class="space-y-2 text-stone-400">
              <li><a href="/mentions-legales/" class="hover:text-amber-400 transition-colors">Mentions Légales</a></li>
              <li><a href="/politique-confidentialite/" class="hover:text-amber-400 transition-colors">Politique de Confidentialité</a></li>
              <li><span class="text-stone-500">100% Cookieless RGPD</span></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-stone-800/80 pt-6 flex flex-col sm:flex-row justify-between items-center text-[11px] text-stone-500">
          <p>© {new Date().getFullYear()} SXM Immo — Conseil immobilier binational.</p>
          <p class="mt-2 sm:mt-0 font-semibold text-amber-500">LEXINGTON WILLIAMSBURG ARCHITECTURE</p>
        </div>
      </div>
    </footer>
  </body>
</html>
