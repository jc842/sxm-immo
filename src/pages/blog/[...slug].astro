---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title + ' — SXM Immo'} description={post.data.description}>
  <article class="py-12 bg-stone-950">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      
      <!-- Breadcrumb -->
      <div class="flex items-center gap-2 text-xs text-stone-400 mb-6 font-semibold">
        <a href="/" class="hover:text-amber-400">Accueil</a>
        <span>/</span>
        <a href="/blog/" class="hover:text-amber-400">Analyses</a>
        <span>/</span>
        <span class="text-amber-400">{post.data.category || 'Immobilier'}</span>
      </div>

      <!-- Header -->
      <header class="border-b border-stone-800 pb-8 mb-8">
        <span class="text-xs uppercase tracking-widest text-amber-400 font-semibold mb-3 block">SXM IMMO OBSERVATOIRE</span>
        <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
          {post.data.title}
        </h1>
        <div class="mt-4 flex items-center gap-4 text-xs text-stone-400">
          <span>Publié le {new Date(post.data.pubDate).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          <span>•</span>
          <span>Rédaction SXM Immo</span>
        </div>
      </header>

      <!-- Content -->
      <div class="prose prose-invert prose-stone max-w-none prose-headings:font-bold prose-headings:text-white prose-a:text-amber-400 leading-relaxed text-stone-300">
        <Content />
      </div>

      <!-- Footer -->
      <footer class="mt-12 border-t border-stone-800 pt-8 text-xs flex justify-between items-center text-stone-400">
        <a href="/blog/" class="text-amber-400 hover:underline font-semibold">← Retour aux analyses</a>
        <span>SXM Immo Intelligence</span>
      </footer>
    </div>
  </article>
</Layout>
