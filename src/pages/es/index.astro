---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog-es');
---

<Layout title="SXM Immo — Inmobiliario Saint-Martin y Sint Maarten en Español" lang="es">
  <section class="border-b border-amber-950/60 bg-stone-950 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-950/30 px-3.5 py-1 text-xs text-amber-300 font-semibold mb-4">
        EDICIÓN EN ESPAÑOL
      </div>
      <h1 class="text-3xl font-extrabold text-white sm:text-5xl">Inmobiliario Binacional en Saint-Martin y Sint Maarten</h1>
      <p class="mt-4 max-w-2xl text-stone-300 text-sm sm:text-base leading-relaxed font-light">
        Guía integral sobre ventajas fiscales, comunidades cerradas en Terres Basses y oportunidades de inversión en el Caribe.
      </p>
    </div>
  </section>

  <section class="py-12 bg-stone-950">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {posts.map(post => (
          <article class="flex flex-col justify-between rounded-xl border border-stone-800 bg-stone-900/50 p-6 hover:border-amber-500/50 transition-colors">
            <div>
              <span class="rounded bg-amber-950 px-2 py-0.5 text-[11px] text-amber-300 font-semibold">{post.data.category}</span>
              <h2 class="text-lg font-bold text-white mt-3 hover:text-amber-400 transition-colors">
                <a href={'/es/' + post.id + '/'}>{post.data.title}</a>
              </h2>
              <p class="mt-2 text-xs text-stone-400 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-stone-800 text-xs">
              <a href={'/es/' + post.id + '/'} class="text-amber-400 hover:underline font-semibold">Leer Guía →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
